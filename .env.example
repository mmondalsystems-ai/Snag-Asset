# Supabase > Connect > Transaction pooler (port 6543). Prefer an alphanumeric DB password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DB_POOL_MAX=1
# Apps Script web app (Drive proxy + sheet sync), see apps_script/SnagSync.gs
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
APPS_SCRIPT_TOKEN=put-the-token-created-by-SnagSync_createToken-here
